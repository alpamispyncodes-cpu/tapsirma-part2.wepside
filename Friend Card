<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Friend Card</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:sans-serif;
    }

    body{
      height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      background:#1f1f1f;
    }

    .card{
      width:230px;
      background:white;
      border-radius:10px;
      overflow:hidden;
      box-shadow:0 5px 15px rgba(0,0,0,0.3);
    }

    .card img{
      width:100%;
      height:220px;
      object-fit:cover;
    }

    .content{
      padding:15px;
    }

    h2{
      font-size:28px;
      margin-bottom:10px;
    }

    .friends{
      display:flex;
      align-items:center;
      gap:10px;
      color:gray;
      margin-bottom:15px;
    }

    .friends img{
      width:30px;
      height:30px;
      border-radius:50%;
    }

    button{
      width:100%;
      padding:12px;
      border:none;
      border-radius:6px;
      background:#35b6ff;
      color:white;
      font-size:18px;
      cursor:pointer;
    }

    button:hover{
      background:#1ea4f0;
    }
  </style>
</head>

<body>

  <div class="card">

    <img src="cat.jpg" alt="cat">

    <div class="content">

      <h2>Oliver</h2>

      <div class="friends">
        <img src="profile.jpg" alt="">
        <p>2 mutual friends</p>
      </div>

      <button>Add Friend</button>

    </div>

  </div>

</body>
</html>
